# Python cache files
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Python build / packaging files
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/
conda-env/

# IDE and system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp

# Local private datasets not included in the public repository
raw_data/
full_data/
private_data/
local_data/
intermediate_data/
large_data/

# Local outputs not intended for public release
local_outputs/
debug_outputs/
temp_outputs/

# Large model or binary files
*.pkl
*.joblib
*.model
*.ubj

# Keep public sample data and example outputs
!sample_data/
!sample_data/*.csv
!example_outputs/
